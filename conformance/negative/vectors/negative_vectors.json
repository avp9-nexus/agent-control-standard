    {
      "id": "3e191ba654dee621aafaf8bcbb4af331b15dc60aa60ec3545f5ec0e1f30afdc0",
      "category": 1,
      "description": "Correctly-signed action targeting an item whose state no longer carries it: the auction is already settled. Signature verification alone passes; only consulting state catches it.",
      "input": {
        "action": {
          "type": "commit_funds",
          "target": "auction-41",
          "amount": "1000"
        },
        "authorization": {
          "signature": "VALID",
          "signer": "agent-A",
          "scope": "auction-41"
        },
        "state": {
          "auction-41": {
            "open": false,
            "settled": true
          }
        }
      },
      "expected": {
        "verdict": "REJECT",
        "code": "CONTEXT_NOT_SUPPORTED",
        "reason_must_mention": [
          "settled"
        ]
      },
      "positive_control": false,
      "requirement": {
        "spec_version": "0.1.2",
        "profile": "ACS-Core",
        "anchor": "docs/spec/conformance.md#acs-core-mandatory-baseline",
        "clause": "SessionContext and Intent",
        "quote": "session_id, chain_hash (rolling SHA-256), append-only ContextEntry chain",
        "ledger_id": null
      }
    },
