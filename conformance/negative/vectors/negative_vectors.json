      "id": "346b52900129b6b85e6ec38f8709bc13ee871e5c12c5465776a0ac73a1d901cd",
      "category": 2,
      "description": "Replayed authorization: the same one-time approval presented for a second act. One authorization covers one act; the second presentation must fail even though every byte is valid.",
      "input": {
        "action": {
          "type": "commit_funds",
          "target": "auction-43",
          "amount": "1000"
        },
        "authorization": {
          "signature": "VALID",
          "signer": "agent-A",
          "one_time_id": "auth-777",
          "consumed": true
        },
        "state": {
          "auction-43": {
            "open": true,
            "settled": false
          }
        }
      },
      "expected": {
        "verdict": "REJECT",
        "code": "REPLAY_CONSUMED",
        "reason_must_mention": [
          "already"
        ]
      },
      "positive_control": false,
      "requirement": {
        "spec_version": "0.1.2",
        "profile": "ACS-Core",
        "anchor": "docs/spec/conformance.md#acs-core-mandatory-baseline",
        "clause": "Replay protection",
        "quote": "Guardians MUST reject replays per §10.3",
        "ledger_id": null
      }
    },
